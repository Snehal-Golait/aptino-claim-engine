# Copy this file to .env and fill in your own values. Never commit .env.

# Groq API key (free tier): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model used by all agents.
# llama-3.3-70b-versatile was decommissioned by Groq on 2026-08-16 — use
# openai/gpt-oss-120b (recommended replacement) or qwen/qwen3.6-27b instead.
# If this ever 404s with "model does not exist", check
# https://console.groq.com/docs/deprecations for the current lineup.
GROQ_MODEL=openai/gpt-oss-120b

# Paths (defaults are fine for local runs)
POLICY_PDF_PATH=data/policy/USGIC-CSCIndividualHealthInsurance_2017-2018.pdf
CHROMA_DIR=storage/chroma
BM25_INDEX_PATH=storage/bm25/bm25_index.pkl

# Retrieval tuning
DENSE_TOP_K=15
SPARSE_TOP_K=15
FUSION_TOP_K=10
RERANK_TOP_K=5

# Decision thresholds
MIN_RERANK_SCORE_FOR_CONFIDENT_DECISION=0.15
